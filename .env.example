# Node 22; Railway supplies PORT. Build with npm ci && npm run build.
PORT=3000
SITE_ORIGIN=https://www.skyguardrs.com
# Set true only on verified production service after www/TLS checks.
CANONICAL_REDIRECTS=false
# Secret is server-only; obtain existing service configuration without printing it.
LEAD_API_TOKEN=
LEAD_API_URL=https://diligent-optimism-production-efa0.up.railway.app/api/public/website-lead
# Optional build-time public property ID. Empty keeps provider completely disabled.
# Valid configured properties still require visitor opt-in on each page visit.
ANALYTICS_MEASUREMENT_ID=
# Set true only after GA4 Enhanced Measurement and automatic user-data collection
# are disabled and sanitized event payloads are verified in that real property.
ANALYTICS_MANUAL_MEASUREMENT_VERIFIED=false
# BUILD_DATE is test-only (YYYY-MM-DD); production defaults to America/Chicago today.
